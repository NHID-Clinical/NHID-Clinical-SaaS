# NHID-Clinical SaaS backend — required/optional environment variables.
# Copy into your host's env var editor (e.g. Railway "Raw Editor"). Do not commit
# a real .env file with secrets filled in.

# --- Required ---

# PostgreSQL connection string. On Railway, add the Postgres plugin to this
# project and it will inject this automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stripe billing (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# https://dashboard.stripe.com/webhooks -> add endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Tamper-evident audit chain signing key. Generate with:
#   openssl rand -hex 32
HMAC_SECRET=

# --- Optional ---

# Admin portal credentials — REQUIRED, no default. See below.
ADMIN_USER=admin
# One of ADMIN_PASS_HASH or ADMIN_PASS is REQUIRED — the gateway refuses to
# start without it. There is no default password.
# Preferred (no plaintext secret in the environment):
#   python -c "from saas_layer.admin_auth import hash_password; print(hash_password('...'))"
ADMIN_PASS_HASH=
# Fallback for existing deployments; hashed into memory at startup.
ADMIN_PASS=

# Voice session retention
VOICE_SESSION_TTL_HOURS=24
VOICE_SESSION_PURGE_INTERVAL_SECS=21600

# Only needed if using LLM-based features in llm.py
OPENAI_API_KEY=

# Server port (most hosts inject this automatically)
PORT=8010
