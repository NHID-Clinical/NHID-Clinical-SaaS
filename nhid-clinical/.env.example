# NHID-Clinical SaaS backend — environment variable specification.
#
# Copy the values you need into your host's environment editor (Render:
# Service -> Environment). Do NOT commit a filled-in .env: everything marked
# SECRET below is a credential.
#
# Every variable listed here is one the code actually reads. If you add a
# variable to the code, add it here; if you remove one, remove it here.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the gateway refuses to start, or fails closed, without these
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. PostgreSQL connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI. Use the
# connection *pooler* URI for a web service (port 6543) and keep sslmode=require.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# SECRET. Signing key for the tamper-evident audit chain. Generate with:
#   openssl rand -hex 32
# Changing this breaks verification of every audit record signed with the old
# key, so treat rotation as a migration, not a routine change.
HMAC_SECRET=

# SECRET. Admin portal credential. One of ADMIN_PASS_HASH or ADMIN_PASS is
# required — there is no default password and startup aborts without one.
# Preferred, keeps no plaintext in the environment:
#   python scripts/hash_admin_password.py
ADMIN_PASS_HASH=
# Fallback, hashed into memory at startup. Discouraged: the plaintext is then
# visible in the dashboard and in any process-environment dump.
ADMIN_PASS=
# Not secret, and not required. The username is compared in constant time.
ADMIN_USER=admin

# Exact browser origin(s) allowed to call this API, comma-separated, no
# trailing slash. REQUIRED IN PRODUCTION — startup aborts if APP_ENV=production
# and this is empty, rather than guessing between "broken" and "wide open".
#   CORS_ALLOWED_ORIGINS=https://app.nhid-clinical.org,https://nhid-clinical.org
# Unset outside production, it falls back to the local dev origins.
CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT BEHAVIOUR
# ─────────────────────────────────────────────────────────────────────────────

# Set to "production" on a deployed instance. Turns on the CORS requirement
# above and suppresses development-only response detail.
APP_ENV=production

# Set to 1 when migrations run as a release step (Render preDeployCommand, or
# `python scripts/migrate.py` in your own pipeline). Workers then skip the
# import-time schema bootstrap instead of every one of them issuing DDL on boot.
# Leave unset for local development and tests, which rely on self-bootstrapping.
NHID_SKIP_SCHEMA_BOOTSTRAP=1

# Port to bind. Most hosts inject this; do not hardcode it in a start command.
PORT=8010

# Largest accepted request body, in bytes. Default 10485760 (10 MiB). Ingestion
# is idempotent, so a large upload should be split rather than raised.
MAX_REQUEST_BYTES=10485760

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — only needed if billing is enabled
# ─────────────────────────────────────────────────────────────────────────────
# Without STRIPE_WEBHOOK_SECRET, webhooks are REJECTED rather than trusted.
# That is deliberate: an unverified webhook is an unauthenticated request that
# changes subscription state.

# SECRET. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Not secret — publishable by design.
STRIPE_PUBLISHABLE_KEY=
# SECRET. https://dashboard.stripe.com/webhooks -> your endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────

# Voice session retention.
VOICE_SESSION_TTL_HOURS=24
VOICE_SESSION_PURGE_INTERVAL_SECS=21600

# SECRET. Only required by the optional LLM helpers in llm.py. The evaluation
# engine itself is deterministic and does not call any model.
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SIGN-IN LINKS
# ─────────────────────────────────────────────────────────────────────────────
# How people inside a customer organization sign in. Separate from the
# organization API key, which is what pipelines and scripts use and which is
# unchanged. The session is what puts a person's name on a review decision
# instead of the string "unknown".
#
# REQUIRED IN PRODUCTION. With APP_ENV=production and no sender configured the
# gateway refuses to start -- deliberately. A deployment that silently cannot
# send mail accepts every sign-in request, returns 202, and locks every user
# out with no error anywhere.
#
#   log       development only. Writes the link to stderr, so the whole flow is
#             testable with no provider account and no network. Rejected in
#             production, because a link on the console is a credential anyone
#             with log access can use.
#   resend    https://resend.com
#   postmark  https://postmarkapp.com
EMAIL_BACKEND=log

# SECRET. The provider's API key. Unused by the log backend.
EMAIL_API_KEY=

# The From address. Must be on a domain you have verified with the provider
# (SPF + DKIM in DNS), or the mail is rejected or filed as spam.
EMAIL_FROM=

# Postmark only. Defaults to "outbound".
EMAIL_MESSAGE_STREAM=

# Where sign-in links point -- the FRONTEND origin, not this API's.
# Built from configuration and never from the request's Host header: honouring
# that header lets an attacker POST a sign-in request with a Host they control
# and have the victim mailed a genuine link to the attacker's domain.
APP_BASE_URL=http://localhost:3000

# Parent domain for the session cookie, so a cookie set by api.<domain> is sent
# to app.<domain>. Leave EMPTY in development, where the Vite dev server
# proxies /saas-api to this process and a host-only cookie is correct.
SESSION_COOKIE_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# READ BUT NOT SET BY YOU
# ─────────────────────────────────────────────────────────────────────────────
# REPLIT_DEPLOYMENT, REPLIT_CONNECTORS_HOSTNAME, REPL_IDENTITY,
# WEB_REPL_RENEWAL, NODE_ENV — injected by Replit when running there. On Render
# they are absent and the code falls back to the STRIPE_* variables above.
#
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (set on the static site service, not here)
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL — absolute origin of this API, e.g.
#     https://api.nhid-clinical.org
#   Inlined into the JavaScript bundle at BUILD time, so changing it requires a
#   rebuild. Not a secret: every visitor's browser can read it.
# PORT, BASE_PATH — both required by vite.config.ts or the build fails.
#   BASE_PATH is "/" for a site root, "/<repo>/" for a GitHub Pages project page.
