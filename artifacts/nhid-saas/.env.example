# NHID-Clinical SaaS frontend — build-time environment.
#
# Vite inlines every one of these into the bundle at BUILD time. Nothing here is
# a secret, and nothing here can be a secret: whatever you set is readable by
# anyone who opens the page. API credentials belong in the backend environment.
#
# Changing any of these requires a rebuild to take effect.

# Absolute origin of the deployed API, no trailing slash:
#   VITE_API_BASE_URL=https://api.nhid-clinical.org
#
# Leave unset for local development. The app then calls "/saas-api", which the
# Vite dev server proxies to http://localhost:8010 (see vite.config.ts), so the
# frontend and API appear to share an origin. They do not in production, which
# is the whole reason this variable exists.
VITE_API_BASE_URL=

# Both are REQUIRED by vite.config.ts — the build throws without them.
# PORT is the dev server / preview port.
PORT=3000
# BASE_PATH is the path the app is served from.
#   "/"                      a site root (Render static site, app.example.com)
#   "/NHID-Clinical-SaaS/"   a GitHub Pages project page
BASE_PATH=/
