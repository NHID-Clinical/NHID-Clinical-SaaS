modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NHID Audit Core"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NHID Clinical Bridge"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NHID Clinical Viewer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NHID Clinical App"

[[workflows.workflow]]
name = "NHID Audit Core"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/nhid-audit-core && uvicorn main:app --host 0.0.0.0 --port 8003 --reload"
waitForPort = 8003

[[workflows.workflow]]
name = "NHID Clinical Bridge"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd nhid-clinical && uvicorn replit_backend_bridge:app --host 0.0.0.0 --port 8001 --reload"
waitForPort = 8001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "NHID Clinical Viewer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd nhid-clinical/replit_dashboard && npm run dev"
waitForPort = 5174

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "NHID Clinical App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash nhid-clinical/replit_start_clinical.sh"
waitForPort = 8000

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5174
externalPort = 3002

[[ports]]
localPort = 5175
externalPort = 3003

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 8002
externalPort = 4200

[[ports]]
localPort = 8003
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 5000

[[ports]]
localPort = 20027
externalPort = 3001
